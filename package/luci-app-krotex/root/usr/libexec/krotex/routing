#!/bin/sh

. /usr/share/libubox/jshn.sh
_json_no_warning=1
CONFIG=/etc/krotex/routing.json
CORE_CONFIG=/etc/krotex/config.json
FIREWALL=/usr/libexec/krotex/firewall
LOCK=/var/lock/krotex-setup.lock
LOCKED=0
WORK=
CHANGED=0

cleanup() {
	if [ "$CHANGED" -eq 1 ] && [ -f "$WORK/previous.json" ]; then
		if mv "$WORK/previous.json" "$CONFIG"; then
			"$FIREWALL" apply >/dev/null 2>&1
		else
			printf '[Krotex] Routing recovery retained at %s\n' "$WORK/previous.json" >&2
			WORK=
		fi
	fi
	[ -z "$WORK" ] || rm -rf "$WORK"
	[ "$LOCKED" -eq 0 ] || rmdir "$LOCK"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

reply() {
	json_init
	json_add_int code "$1"
	json_add_string message "$2"
	json_dump
}
fail() { reply 1 "$1"; exit 0; }
valid_mac() {
	case "$1" in ''|*[!a-fA-F0-9:]*) return 1 ;; esac
	printf '%s\n' "$1" | grep -Eq '^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$' || return 1
	[ "$1" != 00:00:00:00:00:00 ] && [ "$((0x${1%%:*} & 1))" -eq 0 ]
}

devices() {
	local expires mac address hostname client_id
	json_init
	json_add_array devices
	if [ -r /tmp/dhcp.leases ]; then
		while read -r expires mac address hostname client_id; do
			valid_mac "$mac" || continue
			json_add_object ''
			json_add_string mac "$mac"
			json_add_string address "$address"
			json_add_string name "$hostname"
			json_close_object
		done < /tmp/dhcp.leases
	fi
	json_close_array
	json_dump
}

read_macs() {
	local enabled kind keys key mac count=0
	MACS=
	json_load "$(cat "$CONFIG" 2>/dev/null)" || return 1
	json_get_var enabled enabled
	[ "$enabled" = 1 ] || return 0
	json_get_type kind macs
	if [ "$kind" = array ]; then
		json_select macs
		json_get_keys keys
		for key in $keys; do
			json_get_type kind "$key"
			[ "$kind" = string ] || return 1
			json_get_var mac "$key"
			valid_mac "$mac" || return 1
			mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
			case " $MACS " in *" $mac "*) continue ;; esac
			count=$((count + 1)); [ "$count" -le 128 ] || return 1
			MACS="${MACS:+$MACS }$mac"
		done
	else
		[ -z "$kind" ] || return 1
		json_get_var mac mac
		valid_mac "$mac" || return 1
		MACS="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
	fi
}

write_macs() {
	local entry
	json_init
	json_add_boolean enabled "$([ -n "$MACS" ] && echo 1 || echo 0)"
	json_add_array macs
	for entry in $MACS; do json_add_string '' "$entry"; done
	json_close_array
}

status() {
	local active=0 MACS
	read_macs || { reply 1 'Invalid saved routing settings.'; return; }
	"$FIREWALL" status && active=1
	write_macs
	json_add_boolean active "$active"
	json_dump
}

save() {
	local request mac enabled kind protocol tag detail MACS entry updated=''
	IFS= read -r request
	[ "${#request}" -le 1024 ] && json_load "$request" || fail 'Invalid routing request.'
	json_get_type kind enabled
	[ "$kind" = boolean ] || fail 'Invalid routing state.'
	json_get_var enabled enabled
	json_get_type kind mac
	[ "$kind" = string ] || fail 'Invalid MAC address.'
	json_get_var mac mac
	mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
	if [ "$enabled" = 1 ] || [ -n "$mac" ]; then
		valid_mac "$mac" || fail 'Enter a valid unicast device MAC address.'
	fi
	mkdir "$LOCK" 2>/dev/null || fail 'Another Krotex operation is running.'
	LOCKED=1
	read_macs || fail 'Invalid saved routing settings.'
	for entry in $MACS; do
		[ "$entry" = "$mac" ] || updated="${updated:+$updated }$entry"
	done
	if [ "$enabled" = 1 ]; then
		case " $MACS " in
			*" $mac "*) updated=$MACS ;;
			*)
				set -- $updated
				[ "$#" -lt 128 ] || fail 'A maximum of 128 devices is supported.'
				updated="${updated:+$updated }$mac"
				;;
		esac
	elif [ -z "$mac" ]; then
		updated=
	fi
	MACS=$updated
	if [ "$enabled" = 1 ]; then
		json_load "$(cat "$CORE_CONFIG" 2>/dev/null)" && json_select outbounds && json_select 1 || fail 'Configure a VLESS connection first.'
		json_get_var protocol protocol
		json_get_var tag tag
		[ "$protocol" = vless ] && [ "$tag" = proxy ] || fail 'Configure a VLESS connection first.'
		[ -f /var/run/krotex/routing-service-active ] || fail 'Start Krotex before enabling device routing.'
	fi
	umask 077
	WORK="$(mktemp -d /etc/krotex/.routing.XXXXXX)" || fail 'Unable to create temporary files.'
	cp "$CONFIG" "$WORK/previous.json" || fail 'Unable to back up routing settings.'
	write_macs
	json_dump > "$WORK/new.json" || fail 'Unable to generate routing settings.'
	mv "$WORK/new.json" "$CONFIG" || fail 'Unable to save routing settings.'
	CHANGED=1
	if ! "$FIREWALL" apply > "$WORK/error" 2>&1; then
		detail="$(head -c 512 "$WORK/error")"
		fail "Unable to apply device routing. $detail"
	fi
	CHANGED=0
	reply 0 'Device routing settings applied.'
}

case "$1" in
	devices) devices ;;
	routing) status ;;
	set_routing) save ;;
	*) exit 2 ;;
esac
