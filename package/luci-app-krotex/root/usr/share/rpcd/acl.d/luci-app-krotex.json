{
  "luci-app-krotex": {
    "description": "Read Krotex status and control its service",
    "read": {
      "ubus": {
        "krotex": ["status", "connection", "devices", "routing", "sections"]
      }
    },
    "write": {
      "ubus": {
        "krotex": ["action", "save_connection", "test_connection", "set_routing", "set_routing_mode", "save_sections", "test_section"]
      }
    }
  }
}
