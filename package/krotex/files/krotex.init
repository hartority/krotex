#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/xray
[ ! -x /usr/libexec/krotex/xray ] || PROG=/usr/libexec/krotex/xray
CONF=/etc/krotex/config.json
TRANSPARENT=/usr/share/krotex/transparent.json

start_service() {
	[ -x "$PROG" ] && [ -r "$CONF" ] && [ -r "$TRANSPARENT" ] || return 1

	# Reject invalid configuration before registering a respawning instance.
	"$PROG" run -test -config "$CONF" -config "$TRANSPARENT" || return 1

	procd_open_instance main
	procd_set_param command "$PROG" run -config "$CONF" -config "$TRANSPARENT"
	procd_set_param file "$CONF" "$TRANSPARENT"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_started() {
	/usr/libexec/krotex/firewall start
}

stop_service() {
	/usr/libexec/krotex/firewall stop
}
