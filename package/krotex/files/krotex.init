#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/xray
[ ! -x /usr/libexec/krotex/xray ] || PROG=/usr/libexec/krotex/xray
CONF=/etc/krotex/config.json
TRANSPARENT=/usr/share/krotex/transparent.json
FIREWALL=/usr/libexec/krotex/firewall

start_service() {
	# Install protection before validating or launching the core.
	"$FIREWALL" arm || return 1
	[ -x "$PROG" ] && [ -r "$CONF" ] && [ -r "$TRANSPARENT" ] || return 1

	# Reject invalid configuration before registering a respawning instance.
	# Xray replaces the routing object when merging configs. Load the defaults
	# first, so the compiled section rules take precedence.
	"$PROG" run -test -config "$TRANSPARENT" -config "$CONF" || return 1

	procd_open_instance main
	procd_set_param command "$PROG" run -config "$TRANSPARENT" -config "$CONF"
	procd_set_param file "$CONF" "$TRANSPARENT"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_started() {
	"$FIREWALL" start
}

stop_service() {
	case "${action:-stop}:${KROTEX_KEEP_ROUTING:-0}" in
		restart:*|reload:*|shutdown:*|*:1) "$FIREWALL" hold ;;
		*) "$FIREWALL" stop ;;
	esac
}
